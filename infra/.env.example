# Génère la clé maîtresse : python -m core.security.crypto --generate
NOVA_MASTER_KEY=
POSTGRES_PASSWORD=
NOVA_WHATSAPP_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
EVO_KEY=
# Domaine nu (DNS -> l'IP de ce serveur, ports 80/443 ouverts) : Caddy s'en
# sert pour obtenir et renouveler le certificat TLS automatiquement.
NOVA_DOMAIN=nova.tondomaine.fr
# Même hôte que NOVA_DOMAIN, avec le schéma — sert à construire les URLs
# (webhook Evolution, redirect OAuth). Les deux doivent rester synchronisés.
PUBLIC_URL=https://nova.tondomaine.fr
LANGFUSE_SECRET=
LANGFUSE_SALT=

# OAuth Google (core/api/oauth.py) — client OAuth 2.0 "Web application"
# depuis Google Cloud Console. Optionnel : sans lui, calendar.*/mail.* ne
# sont simplement pas proposés (à moins que Microsoft, ci-dessous, le soit).
NOVA_GOOGLE_CLIENT_ID=
NOVA_GOOGLE_CLIENT_SECRET=
NOVA_GOOGLE_REDIRECT_URI=${PUBLIC_URL}/oauth/google/callback

# OAuth Microsoft (core/api/oauth.py + core/integrations/microsoft_oauth.py) —
# app enregistrée sur le Microsoft Entra admin center (comptes personnels et
# professionnels/scolaires, tenant "common"). Optionnel, et alternatif à
# Google pour calendar.* : `core/workers.py` choisit Google en priorité si
# les deux sont configurés — un déploiement ne sert jamais les deux à la fois
# pour un même utilisateur. Pas d'équivalent mail.*/Gmail côté Microsoft.
NOVA_MICROSOFT_CLIENT_ID=
NOVA_MICROSOFT_CLIENT_SECRET=
NOVA_MICROSOFT_REDIRECT_URI=${PUBLIC_URL}/oauth/microsoft/callback

# Signe le state anti-CSRF, partagé par les deux flows OAuth : `openssl rand -base64 32`
NOVA_OAUTH_STATE_SECRET=
# Sans dashboard/login, ce secret tient lieu d'authentification sur
# /oauth/google/start — c'est lui qui empêche n'importe qui de lier son
# propre compte Google à l'identité d'un autre utilisateur Nova.
# `openssl rand -base64 32`
NOVA_OAUTH_START_SECRET=

# Nom de l'instance Evolution API (créée via son API, pas ici) — le worker
# l'utilise pour envoyer les réponses WhatsApp sortantes.
NOVA_EVOLUTION_INSTANCE=

# Protège /admin/pairing-code — le seul moyen d'émettre le premier code
# d'appairage WhatsApp d'un utilisateur, faute de dashboard. `openssl rand
# -base64 32`
NOVA_ADMIN_SECRET=
